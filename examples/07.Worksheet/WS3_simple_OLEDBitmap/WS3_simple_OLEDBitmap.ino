    0,                // พิกัด X เริ่มต้นที่มุมซ้ายสุด
    0,                // พิกัด Y เริ่มต้นที่มุมบนสุด
    image_data,       // ชื่ออาเรย์ข้อมูลรูปภาพ
    IMAGE_WIDTH,      // ความกว้างของภาพ (128 พิกเซล)
    IMAGE_HEIGHT,     // ความสูงของภาพ (64 พิกเซล)
    SSD1306_WHITE     // สีที่ใช้แสดงผล (พิกเซลสว่าง)
  );
  
  kit.displayUpdate(); // อัปเดตแสดงผลออกหน้าจอ
  delay(2000);
}